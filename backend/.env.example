# MotherSync AI Backend Environment Configuration Example

PORT=5000
NODE_ENV=development
# Allowed Frontend Origins for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app,http://localhost:5173)
FRONTEND_URL=https://mothersync-ai.vercel.app,http://localhost:5173

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pregnancy_guardian?retryWrites=true&w=majority

# Google Gemini API Key & Model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# JWT Authentication Secret
JWT_SECRET=mothersync_ultra_secure_jwt_secret_token_2026_maternal_ai
AUTH_SECRET=mothersync_ultra_secure_jwt_secret_token_2026_maternal_ai

# File Storage Configuration
STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads

# Optional: Google Maps / Places API Key
MAPS_API_KEY=
