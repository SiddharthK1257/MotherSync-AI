# MotherSync AI Root Environment Configuration Example

# Frontend API Configuration (Vite environment variable for production frontend e.g. Vercel)
# Local Development: http://localhost:5000/api
# Production: https://<YOUR_DEPLOYED_BACKEND>/api (e.g. https://mothersync-ai.onrender.com/api)
VITE_API_URL=https://mothersync-ai.onrender.com/api

# Backend Configuration
PORT=5000
NODE_ENV=production
# Backend Allowed Frontend Origins for CORS (e.g. https://your-app.vercel.app,http://localhost:5173)
FRONTEND_URL=https://mothersync-ai.vercel.app,http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pregnancy_guardian?retryWrites=true&w=majority
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
JWT_SECRET=mothersync_ultra_secure_jwt_secret_token_2026_maternal_ai
AUTH_SECRET=mothersync_ultra_secure_jwt_secret_token_2026_maternal_ai
STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads
